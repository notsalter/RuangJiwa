# Firebase configuration for the web app.
# Copy to .env (git-ignored) and fill in from the Firebase console.
# Web API keys are client identifiers, not secrets — access control lives in
# Firestore/Storage security rules. Never commit real values anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional self-hosted backend instead of Firebase (see docs/SETUP.md).
# Set VITE_BACKEND=http and point VITE_API_URL at the server/ API. The URL must
# be https unless the host is loopback, and must not embed credentials.
# VITE_BACKEND=http
# VITE_API_URL=http://localhost:3000

# Build base. Unset or empty means the domain root; use /RuangJiwa/ for a
# GitHub Pages project site.
# VITE_BASE_PATH=/

# Local emulator opt-in. Requires both variables and the exact demo project id.
# Never enable for a deployment.
# VITE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_PROJECT_ID=demo-ruangjiwa
